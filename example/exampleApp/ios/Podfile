def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# react-native-permissions 5.6 needs iOS 15.1; React Native's own minimum is lower.
platform :ios, '15.1'
prepare_react_native_project!

setup_permissions(['Notifications'])

# A local build of the native iOS SDK: MINDBOX_IOS_SDK_PATH=/path/to/ios-sdk pod install.
# Without the variable the pods come from trunk, as in an ordinary integration.
MINDBOX_IOS_SDK_PATH = ENV['MINDBOX_IOS_SDK_PATH']

def mindbox_pod(name)
  if MINDBOX_IOS_SDK_PATH
    pod name, :path => MINDBOX_IOS_SDK_PATH
  else
    pod name
  end
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'exampleApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  mindbox_pod 'Mindbox'
  mindbox_pod 'MindboxLogger' if MINDBOX_IOS_SDK_PATH

target 'MindboxNotificationServiceExtension' do
     mindbox_pod 'MindboxNotifications'
  end

target 'MindboxNotificationContentExtension' do
   mindbox_pod 'MindboxNotifications'
  end

  post_install do |installer|
    installer.pods_project.targets.each do |target|
       target.build_configurations.each do |config|
         config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'No'
       end
     end
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end

